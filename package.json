{
  "name": "postify",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "up": "./start.sh",
    "up:local": "START_MODE=local ./start.sh",
    "up:docker": "START_MODE=docker ./start.sh",
    "check:node": "node scripts/check-node-version.cjs",
    "build": "npm run check:node && next build",
    "start": "next start",
    "lint": "npm run check:node && eslint .",
    "lint:gate": "npm run check:node && node scripts/lint-gate.cjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "ioredis": "^5.10.1",
    "nodemailer": "^6.9.16",
    "next": "16.2.2",
    "next-auth": "^4.24.13",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tumblr.js": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
