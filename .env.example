# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postify"

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
TOKEN_ENCRYPTION_KEY="generate-with: openssl rand -base64 32"
ENABLE_DEV_AUTH="false"
NEXT_PUBLIC_ENABLE_DEV_AUTH="false"
# Set true to bypass DB adapter (dev mode with any email/password)
AUTH_USE_PRISMA_ADAPTER="false"

# ─── SMTP (for transactional email) ──────────────────────────────────────────
# Used for: email verification, password reset
# Skip if using dev mode (login emails are logged to console)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Postify <noreply@postify.app>"

# ─── LinkedIn OAuth ──────────────────────────────────────────────────────────
# Create app at: https://developer.linkedin.com/apps
# Required scopes: r_organization_social, w_organization_social,
#                  rw_organization_admin, r_basicprofile, openid, profile, email
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ─── Meta (Facebook + Instagram + Threads) ───────────────────────────────────
# Create app at: https://developers.facebook.com/apps
# Required: pages_manage_posts, pages_read_engagement, groups_access_member_info,
#           publish_to_groups, instagram_basic, instagram_content_publish,
#           threads_basic, threads_content_publish
META_CLIENT_ID=""
META_CLIENT_SECRET=""

# ─── Twitter / X ─────────────────────────────────────────────────────────────
# Create app at: https://developer.twitter.com/apps
# Required plan: Basic ($100/mo) for write access
# Scopes: tweet.read, tweet.write, users.read, offline.access
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# ─── Bluesky ─────────────────────────────────────────────────────────────────
# No OAuth app needed — users enter handle + app password directly
# Generate app passwords at: https://bsky.app/settings/app-passwords

# ─── Pinterest ────────────────────────────────────────────────────────────────
# Create app at: https://developers.pinterest.com/apps
# Scopes: pins:read, pins:write, boards:read, boards:write
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""

# ─── Tumblr ───────────────────────────────────────────────────────────────────
# Create app at: https://www.tumblr.com/oauth/apps
# Uses OAuth 1.0a
TUMBLR_CONSUMER_KEY=""
TUMBLR_CONSUMER_SECRET=""

# ─── Redis (for BullMQ job scheduler) ────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Cloudinary (media uploads) ───────────────────────────────────────────────
# Free tier: 25GB storage, 25GB bandwidth/month
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Secures the token refresh endpoint. Generate with: openssl rand -hex 20
CRON_SECRET=""

# ─── Google OAuth (for app login) ─────────────────────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials
# Redirect URI: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
